# An mwan3 config shaped like the live gateway's (mwan3 2.11, service disabled),
# placeholders only: WAN 1 and WAN 2 share metric 1 in the default rule's policy (load
# balancing, not failover), a third WAN sits at metric 2 outside that policy, and a
# sticky HTTPS/QUIC rule uses the same policy as the default rule.
config globals 'globals'
	option mmx_mask '0x3F00'
	option rtmon_interval '5'
	option logging '1'

config interface 'wan'
	option enabled '1'
	list track_ip '203.0.113.1'
	list track_ip '198.51.100.1'
	option family 'ipv4'
	option reliability '2'
	option count '3'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '8'

config interface 'lan2'
	option enabled '1'
	list track_ip '203.0.113.1'
	list track_ip '198.51.100.1'
	option family 'ipv4'
	option reliability '2'
	option count '3'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '8'

config interface 'globe'
	option enabled '1'
	list track_ip '203.0.113.1'
	list track_ip '198.51.100.1'
	option family 'ipv4'
	option reliability '1'
	option count '3'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '8'

config member 'wan_member'
	option interface 'wan'
	option metric '1'
	option weight '1'

config member 'lan2_member'
	option interface 'lan2'
	option metric '1'
	option weight '1'

config member 'globe_member'
	option interface 'globe'
	option metric '2'
	option weight '1'

config policy 'wan_only'
	list use_member 'wan_member'
	option last_resort 'unreachable'

config policy 'balanced_failover'
	list use_member 'wan_member'
	list use_member 'lan2_member'
	option last_resort 'unreachable'

config rule 'https_quic_sticky'
	option name 'HTTPS_QUIC_Sticky_Balanced'
	option dest_port '443'
	option proto 'tcp udp'
	option sticky '1'
	option use_policy 'balanced_failover'
	option family 'ipv4'

config rule 'default_rule'
	option name 'Default_Balanced_Failover'
	option dest_ip '0.0.0.0/0'
	option proto 'all'
	option sticky '1'
	option use_policy 'balanced_failover'
	option family 'ipv4'
