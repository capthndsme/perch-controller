# Options and cake keywords Perch does not model: they must survive every write.
config queue 'wan'
	option enabled '1'
	option interface 'wan'
	option download '300000'
	option upload '20000'
	option qdisc 'cake'
	option script 'layer_cake.qos'
	option linklayer 'none'
	option qdisc_advanced '1'
	option qdisc_really_really_advanced '1'
	option ilimit '1000'
	option elimit '1000'
	option itarget 'auto'
	option etarget 'auto'
	option shaper_burst '1'
	option future_option 'kept verbatim'
	list future_list 'a'
	list future_list 'b'
	option eqdisc_opts 'nat ack-filter dual-srchost memlimit 32mb wash'
	option iqdisc_opts 'nat dual-dsthost ingress rtt 50ms'
