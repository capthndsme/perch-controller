# The live gateway's hand-made queue (2026-09-23), rates rounded to placeholders:
# layer_cake, NAT-aware per-host fairness, ~970 Mbit/s each way on one WAN.
config queue 'eth1'
	option enabled '1'
	option interface 'wan0'
	option download '970000'
	option upload '970000'
	option qdisc 'cake'
	option script 'layer_cake.qos'
	option linklayer 'none'
	option debug_logging '0'
	option verbosity '5'
	option qdisc_advanced '1'
	option squash_dscp '1'
	option squash_ingress '1'
	option ingress_ecn 'ECN'
	option egress_ecn 'NOECN'
	option qdisc_really_really_advanced '1'
	option iqdisc_opts 'nat dual-dsthost ingress'
	option eqdisc_opts 'nat dual-srchost'
