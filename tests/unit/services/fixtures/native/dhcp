# A dhcp config shaped like an OpenWrt 24.10 router's (placeholders only).
config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option localservice '1'
	option ednspacket_max '1232'
	option port '54'
	list server '203.0.113.53'
	list server '/corp.example.com/192.168.1.53'
	list rebind_domain 'perch.example.com'
	list address '/ads.example.com/'
	list notinterface 'wan'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '1200d'
	option dhcpv4 'server'
	option dhcpv6 'server'
	option ra 'server'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	list dhcp_option '6,192.168.1.1,203.0.113.53'
	list dhcp_option '42,192.168.1.1'
	list dhcp_option 'option:domain-search,lan'

config dhcp 'guest'
	option interface 'guest'
	option start '100'
	option limit '100'
	option leasetime '1h'
	list dhcp_option '3,192.168.30.1'
	list dhcp_option '6,203.0.113.53'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

config tag 'kids'
	list dhcp_option '6,192.168.1.2'
	option force '1'

config host
	option name 'tablet'
	option mac '02:00:00:00:10:21'
	option ip '192.168.1.21'
	option tag 'kids'

config host
	option name 'nas'
	list mac '02:00:00:00:10:30'
	option ip '192.168.1.30'
	option leasetime 'infinite'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
