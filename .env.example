# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# Comma-separated list of allowed origins. Production-only — in dev
# every origin is allowed automatically.
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------
# `npm test` overrides DB_DATABASE via .env.test so tests run against a
# separate `<name>_test` schema and never truncate dev/prod data. Create
# the test database once before running tests, e.g.:
#   mysql -u root -p -e "CREATE DATABASE IF NOT EXISTS hypermetrics_test"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

#--------------------------------------------------------------------
# Scheduler (poller runs inside the HTTP server)
#--------------------------------------------------------------------
SCHEDULER_HTTP_SERVER=true

#--------------------------------------------------------------------
# Tiered bucket retention (daily prune at 03:30)
#--------------------------------------------------------------------
# Rows are deleted per tier once older than its horizon:
#   BUCKET_RETENTION_DAYS         native (~5 s) tables   (default 30)
#   BUCKET_5M_RETENTION_DAYS      5-minute rollups       (default 730 = 2 yr)
#   BUCKET_HOURLY_RETENTION_DAYS  hourly rollups         (default 730 = 2 yr)
# The coarse tiers default to a 2-year wall so the DB settles at a steady
# size. Each coarser tier is clamped to live at least as long as the finer
# one below it. Set BUCKET_RETENTION_DAYS to 0 to disable the whole sweep.
BUCKET_RETENTION_DAYS=30
BUCKET_5M_RETENTION_DAYS=730
BUCKET_HOURLY_RETENTION_DAYS=730
#   BUCKET_DAILY_RETENTION_DAYS   daily rollups          (default 1825 = 5 yr)
#   WIFI_SNAPSHOT_RETENTION_DAYS  raw wifi station/network/system snapshots (default 14)
#   WIFI_EVENT_RETENTION_DAYS     wifi roaming events    (default 90)
#   PEER_HOURLY_RETENTION_DAYS    hourly peer history    (default 90)
BUCKET_DAILY_RETENTION_DAYS=1825
WIFI_SNAPSHOT_RETENTION_DAYS=14
WIFI_EVENT_RETENTION_DAYS=90
PEER_HOURLY_RETENTION_DAYS=90
SERVICE_HOURLY_RETENTION_DAYS=365
DESTINATION_HOURLY_RETENTION_DAYS=365
SERVICE_5M_RETENTION_DAYS=14
ROUTER_SAMPLE_RETENTION_DAYS=90

#--------------------------------------------------------------------
# MariaDB runtime tuning (applied at boot + every 15 min via SET GLOBAL)
#--------------------------------------------------------------------
# Belt-and-braces for hosts without root access to /etc/mysql; the durable
# config is docs/ops/mariadb-perch.cnf. 0 / unset disables each knob.
DB_TUNE_BUFFER_POOL_BYTES=0
DB_TUNE_FLUSH_LOG_AT_TRX_COMMIT=

#--------------------------------------------------------------------
# Counter-reset glitch guard
#--------------------------------------------------------------------
# Drop (and log) any single bucket delta whose in/out bytes exceed this,
# instead of writing a spike. A device counter reset can make the collector
# record a whole cumulative counter as one bucket. Default 5 GB; set 0 to
# disable.
BUCKET_MAX_DELTA_BYTES=5000000000

#--------------------------------------------------------------------
# Edge router (gateway) health
#--------------------------------------------------------------------
# Nothing to configure here: the Perch Network Collector on the router reports
# conntrack fill, established TCP, load, memory and WAN counters with its
# traffic data (gateway_stats auto = on under OpenWrt). Samples are kept for
# ROUTER_SAMPLE_RETENTION_DAYS above.

#--------------------------------------------------------------------
# Lock store (in-memory mutex; single-process deployment)
#--------------------------------------------------------------------
LOCK_STORE=memory

# Register this collector automatically at boot when none exists yet (the
# Docker setup uses it so the wizard skips the collector step). Optional. The
# row it creates is marked source=env and follows this URL on later boots;
# collectors that announced themselves are never moved by it.
# COLLECTOR_URL=http://127.0.0.1:9800
# COLLECTOR_API_KEY=

# Perch AP Daemon install commands (Settings → Wi-Fi sources → join tokens,
# docs/ap-controller.md). Both optional. AP_AGENT_RELEASE_URL is where the
# commands download perch-apd from (default: its GitHub release this controller
# pairs with, see PERCH_APD_VERSION); AP_AGENT_CONTROLLER_URL is the server URL
# they tell the AP to use (default: the address the dashboard was opened at,
# which is right behind most proxies).
# AP_AGENT_RELEASE_URL=https://mirror.example.com/perch-apd
# AP_AGENT_CONTROLLER_URL=https://metrics.example.com

# The daemon releases the install commands download (default: the ones this
# controller release was cut with, package.json "perch"); a version or latest.
# PERCH_APD_VERSION=latest
# PERCH_COLLECTOR_VERSION=latest

# ---- Docker stack (docker-compose.yml reads this same file) ----
# All optional; the compose file header documents each one. An install that
# started under the old project name keeps its containers and database volume
# with COMPOSE_PROJECT_NAME (e.g. COMPOSE_PROJECT_NAME=metricslite).
# PERCH_IMAGE_TAG=latest
# PERCH_HTTP_PORT=8080
# PERCH_HTTP_BIND=0.0.0.0
# PERCH_CAPTURE_INTERFACE=
# PERCH_GATEWAY_MACS=
# PERCH_COLLECTOR_API_KEY=
# PERCH_DB_BUFFER_POOL=512M
# PERCH_SSH_DIR=/home/you/.ssh
# PERCH_NET_SUBNET=172.28.0.0/24
# PERCH_NET_GATEWAY=172.28.0.1
# Whose X-Forwarded-For the server believes (proxy-addr list syntax: addresses,
# CIDR ranges, and/or the loopback / linklocal / uniquelocal presets). Default
# `loopback` covers a reverse proxy on the same box. docker-compose.yml sets
# `loopback,${PERCH_NET_GATEWAY}` on the server service, because a proxy
# on the host reaches the container from the stack gateway — the gateway
# address only, not the whole subnet, since every sibling container sits on
# that subnet and could otherwise forge the header. Keep this list as narrow
# as the deployment allows: it matters beyond logging, because the address a
# collector is polled at is derived from request.ip() when it announces.
# TRUST_PROXY=loopback,172.28.0.1
# COMPOSE_FILE=docker-compose.yml:docker-compose.db-port.yml   # + loopback DB port for host tooling
