# Base URL of the metricslite API. Leave EMPTY (the default): the API serves the
# dashboard itself and calls stay same-origin. Set an absolute URL only when the
# dashboard is hosted on a different origin than the API.
VITE_API_URL=

# `npm run dev` proxies /api to this address (defaults to http://localhost:3333).
# VITE_DEV_API_PROXY=http://localhost:3333
