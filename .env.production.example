# Production overrides merged over .env by ../deploy.sh into build/.env.
# Keys here win over .env. Secrets (APP_KEY, DB_PASSWORD) stay in .env.
# Copy to .env.production and adjust for your site.
NODE_ENV=production
HOST=0.0.0.0
# PORT is not overridden here: .env holds the port your reverse proxy targets.
LOG_LEVEL=info

# CORS allowlist for the API (comma-separated). Unset = fail closed in production.
CORS_ORIGIN=https://metrics.example.com,http://localhost:5173

# Retention ladder (days). See app/services/bucket_retention.ts.
BUCKET_RETENTION_DAYS=30
BUCKET_5M_RETENTION_DAYS=730
BUCKET_HOURLY_RETENTION_DAYS=730
BUCKET_DAILY_RETENTION_DAYS=1825
WIFI_SNAPSHOT_RETENTION_DAYS=14
WIFI_EVENT_RETENTION_DAYS=90
PEER_HOURLY_RETENTION_DAYS=90
SERVICE_HOURLY_RETENTION_DAYS=365
DESTINATION_HOURLY_RETENTION_DAYS=365
SERVICE_5M_RETENTION_DAYS=14
ROUTER_SAMPLE_RETENTION_DAYS=90

# Runtime MariaDB tuning applied by the app at boot + every 15 min (SET GLOBAL).
# The durable config is docs/ops/mariadb-perch.cnf. 0 / empty disables.
DB_TUNE_BUFFER_POOL_BYTES=0
DB_TUNE_FLUSH_LOG_AT_TRX_COMMIT=

# Gateway stats come from the Perch Network Collector on the router; nothing to set.
