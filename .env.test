SESSION_DRIVER=memory
SCHEDULER_HTTP_SERVER=false
LOCK_STORE=memory

# Tests must NEVER touch the dev/prod database. The bootstrap aborts unless
# DB_DATABASE ends in _test, and the runner runs migrations against this
# database on setup and rolls them back on teardown.
DB_DATABASE=hypermetrics_test

# The functional suite starts a real HTTP server. Never let it share a port
# with a running instance: on a host where the live server is published on
# 127.0.0.1:PORT, "localhost" could otherwise reach the live one.
HOST=127.0.0.1
PORT=13334
